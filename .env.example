# Copie para .env.local e preencha quando for ligar o Supabase.
# O protótipo atual NÃO usa nenhuma destas variáveis (roda só com dados mockados).

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Usado só por scripts no seu computador (nunca no front, nunca na Vercel com prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Fuso das regras de horário (freezer fora do horário)
VITE_FUSO=America/Sao_Paulo
